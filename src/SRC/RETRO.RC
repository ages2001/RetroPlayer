#include <windows.h>

/* Application icon. Classic DIB (16-colour) ICO so it renders on
 * Windows NT 3.1 and Windows 95 as well as later systems. */
1 ICON "RETRO.ICO"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "RetroPlayer"
            VALUE "FileDescription", "RetroPlayer media player"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "RETRO"
            VALUE "OriginalFilename", "RETROPLY.EXE"
            VALUE "ProductName", "RetroPlayer"
            VALUE "ProductVersion", "1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
