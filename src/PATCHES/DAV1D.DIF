--- a/src/cpu.c
+++ b/src/cpu.c
@@ -83,7 +83,14 @@
 
 COLD int dav1d_num_logical_processors(Dav1dContext *const c) {
 #ifdef _WIN32
-#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+#if defined(RP_LEGACY)
+    DWORD_PTR mask, system_mask;
+    if (GetProcessAffinityMask(GetCurrentProcess(), &mask, &system_mask) && mask) {
+        int count = 0;
+        do { ++count; } while ((mask &= mask - 1) != 0);
+        return count;
+    }
+#elif WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
     GROUP_AFFINITY affinity;
     if (GetThreadGroupAffinity(GetCurrentThread(), &affinity)) {
         int num_processors = 1;
--- a/src/win32/thread.c
+++ b/src/win32/thread.c
@@ -30,6 +30,7 @@
 #if defined(_WIN32)
 
 #include <process.h>
+#include <stdint.h>
 #include <stdlib.h>
 #include <windows.h>
 
@@ -60,6 +61,25 @@
     return 0;
 }
 
+#ifdef RP_LEGACY
+typedef struct {
+    HANDLE gate;
+    pthread_t *thread;
+    int cancelled;
+} LegacyLaunch;
+static void __cdecl legacy_entrypoint(void *data) {
+    LegacyLaunch *launch = data;
+    DWORD result = WaitForSingleObject(launch->gate, INFINITE);
+    pthread_t *thread = launch->thread;
+    int cancelled = launch->cancelled;
+    CloseHandle(launch->gate);
+    free(launch);
+    if (result == WAIT_OBJECT_0 && !cancelled)
+        thread_entrypoint(thread);
+    _endthread();
+}
+#endif
+
 COLD int dav1d_pthread_create(pthread_t *const thread,
                               const pthread_attr_t *const attr,
                               void *(*const func)(void*), void *const arg)
@@ -67,9 +87,29 @@
     const unsigned stack_size = attr ? attr->stack_size : 0;
     thread->func = func;
     thread->arg = arg;
+#ifdef RP_LEGACY
+    LegacyLaunch *launch = malloc(sizeof(*launch));
+    if (!launch) return 1;
+    launch->thread = thread; launch->cancelled = 0;
+    launch->gate = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!launch->gate) { free(launch); return 1; }
+    uintptr_t original = _beginthread(legacy_entrypoint, stack_size, launch);
+    if (original == (uintptr_t)-1) {
+        CloseHandle(launch->gate); free(launch); return 1;
+    }
+    if (!DuplicateHandle(GetCurrentProcess(), (HANDLE)original, GetCurrentProcess(),
+                         &thread->h, 0, FALSE, DUPLICATE_SAME_ACCESS)) {
+        launch->cancelled = 1;
+        SetEvent(launch->gate);
+        return 1;
+    }
+    SetEvent(launch->gate);
+    return 0;
+#else
     thread->h = (HANDLE)_beginthreadex(NULL, stack_size, thread_entrypoint, thread,
                                        STACK_SIZE_PARAM_IS_A_RESERVATION, NULL);
     return !thread->h;
+#endif
 }
 
 COLD int dav1d_pthread_join(pthread_t *const thread, void **const res) {
@@ -90,10 +130,11 @@
     if (InitOnceBeginInitialize(once_control, 0, &pending, NULL) != TRUE)
         return 1;
 
-    if (pending == TRUE)
+    if (pending == TRUE) {
         init_routine();
-
-    return !InitOnceComplete(once_control, 0, NULL);
+        return !InitOnceComplete(once_control, 0, NULL);
+    }
+    return 0;
 }
 
 #endif
