         if (owner->mixer_format.i_format)
         {
@@ -210,6 +216,9 @@
     aout_owner_t *owner = aout_owner (aout);
 
     owner->sync.resamp_type = AOUT_RESAMPLING_NONE;
+#ifdef RP_LEGACY
+    owner->sync.resamp_duration = 0;
+#endif
     aout_FiltersAdjustResampling (owner->filters, 0);
 }
 
@@ -234,8 +243,11 @@
 }
 
 static void aout_DecSynchronize (audio_output_t *aout, vlc_tick_t dec_pts,
-                                 int input_rate)
-{
+                                 int input_rate, vlc_tick_t duration)
+{
+#ifndef RP_LEGACY
+    VLC_UNUSED(duration);
+#endif
     aout_owner_t *owner = aout_owner (aout);
     vlc_tick_t drift;
 
@@ -312,6 +324,9 @@
                   drift);
         owner->sync.resamp_type = AOUT_RESAMPLING_UP;
         owner->sync.resamp_start_drift = +drift;
+#ifdef RP_LEGACY
+        owner->sync.resamp_duration = 0;
+#endif
     }
     if (drift < -AOUT_MAX_PTS_ADVANCE
      && owner->sync.resamp_type != AOUT_RESAMPLING_DOWN)
@@ -320,6 +335,9 @@
                   drift);
         owner->sync.resamp_type = AOUT_RESAMPLING_DOWN;
         owner->sync.resamp_start_drift = -drift;
+#ifdef RP_LEGACY
+        owner->sync.resamp_duration = 0;
+#endif
     }
 
     if (owner->sync.resamp_type == AOUT_RESAMPLING_NONE)
@@ -344,11 +362,30 @@
          * value, then it is time to switch back the resampling direction. */
         adj *= -1;
 
+#ifdef RP_LEGACY
+    /* A fixed change per packet makes 2.5 ms Opus packets ramp eight times
+     * faster than 20 ms packets, producing an audible pitch sweep. Preserve
+     * the 2 Hz per 20 ms slope using decoded media duration. Retain fractional
+     * intervals across packets, but bound a discontinuous oversized block.
+     * Apply individual steps so returning towards zero cannot overshoot it. */
+    owner->sync.resamp_duration += __MIN(__MAX(duration, 0), CLOCK_FREQ);
+    while (owner->sync.resamp_duration >= 20000)
+    {
+        owner->sync.resamp_duration -= 20000;
+        if (aout_FiltersAdjustResampling(owner->filters, adj))
+            continue;
+        owner->sync.resamp_duration = 0;
+        owner->sync.resamp_type = AOUT_RESAMPLING_NONE;
+        msg_Dbg(aout, "resampling stopped (drift: %"PRId64" us)", drift);
+        break;
+    }
+#else
     if (!aout_FiltersAdjustResampling (owner->filters, adj))
     {   /* Everything is back to normal: stop resampling. */
         owner->sync.resamp_type = AOUT_RESAMPLING_NONE;
         msg_Dbg (aout, "resampling stopped (drift: %"PRId64" us)", drift);
     }
+#endif
 }
 
 /*****************************************************************************
@@ -402,7 +439,7 @@
     aout_volume_Amplify (owner->volume, block);
 
     /* Drift correction */
-    aout_DecSynchronize (aout, block->i_pts, input_rate);
+    aout_DecSynchronize (aout, block->i_pts, input_rate, block->i_length);
 
     /* Output */
     owner->sync.end = block->i_pts + block->i_length + 1;
--- a/src/audio_output/aout_internal.h
+++ b/src/audio_output/aout_internal.h
@@ -80,6 +80,9 @@
         vlc_tick_t end; /**< Last seen PTS */
         unsigned resamp_start_drift; /**< Resampler drift absolute value */
         int resamp_type; /**< Resampler mode (FIXME: redundant / resampling) */
+#ifdef RP_LEGACY
+        vlc_tick_t resamp_duration; /**< Media time awaiting a rate adjustment */
+#endif
         bool discontinuity;
     } sync;
 
