                 if (p_decoder->i_need > p_decoder->i_section_max_size - 3)
                 {
@@ -395,7 +418,7 @@
                         p_new_pos = NULL;
                         p_decoder->i_need = 3;
                         p_decoder->b_complete_header = false;
