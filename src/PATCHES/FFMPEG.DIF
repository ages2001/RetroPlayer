--- a/libavformat/udp.c
+++ b/libavformat/udp.c
@@ -536,26 +536,50 @@
 
     pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &old_cancelstate);
     pthread_mutex_lock(&s->mutex);
-    if (ff_socket_nonblock(s->udp_fd, 0) < 0) {
+    if (ff_socket_nonblock(s->udp_fd,
+#ifdef RP_LEGACY
+                          1
+#else
+                          0
+#endif
+                         ) < 0) {
         av_log(h, AV_LOG_ERROR, "Failed to set blocking mode");
         s->circular_buffer_error = AVERROR(EIO);
         goto end;
     }
     while(1) {
         UDPQueuedPacketHeader pkt_header;
+#ifdef RP_LEGACY
+        if (s->close_req)
+            goto end;
+#endif
         pkt_header.addr_len = sizeof(pkt_header.addr);
 
         pthread_mutex_unlock(&s->mutex);
+#ifdef RP_LEGACY
+        /* Original Winsock has no CancelIoEx. A bounded readiness wait and
+         * nonblocking recv let close join the worker without a fake cancel. */
+        int readiness = ff_network_wait_fd(s->udp_fd, 0);
+        if (readiness < 0) {
+            pthread_mutex_lock(&s->mutex);
+            if (readiness != AVERROR(EAGAIN) && readiness != AVERROR(EINTR)) {
+                s->circular_buffer_error = readiness;
+                goto end;
+            }
+            continue;
+        }
+#endif
         /* Blocking operations are always cancellation points;
            see "General Information" / "Thread Cancellation Overview"
            in Single Unix. */
         pthread_setcancelstate(PTHREAD_CANCEL_ENABLE, &old_cancelstate);
         pkt_header.pkt_size = recvfrom(s->udp_fd, s->tmp + sizeof(pkt_header), sizeof(s->tmp) - sizeof(pkt_header), 0, (struct sockaddr *)&pkt_header.addr, &pkt_header.addr_len);
+        int receive_error = pkt_header.pkt_size < 0 ? ff_neterrno() : 0;
         pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &old_cancelstate);
         pthread_mutex_lock(&s->mutex);
         if (pkt_header.pkt_size < 0) {
-            if (ff_neterrno() != AVERROR(EAGAIN) && ff_neterrno() != AVERROR(EINTR)) {
-                s->circular_buffer_error = ff_neterrno();
+            if (receive_error != AVERROR(EAGAIN) && receive_error != AVERROR(EINTR)) {
+                s->circular_buffer_error = receive_error;
                 goto end;
             }
             continue;
@@ -1113,7 +1137,12 @@
         int ret;
         // Cancel only read, as write has been signaled as success to the user
         if (h->flags & AVIO_FLAG_READ) {
-#ifdef _WIN32
+#if defined(RP_LEGACY)
+            pthread_mutex_lock(&s->mutex);
+            s->close_req = 1;
+            pthread_cond_signal(&s->cond);
+            pthread_mutex_unlock(&s->mutex);
+#elif defined(_WIN32)
             /* recvfrom() is not a cancellation point for win32, so we shutdown
              * the socket and abort pending IO, subsequent recvfrom() calls
              * will fail with WSAESHUTDOWN causing the thread to exit. */
--- a/libavutil/x86/cpu.c
+++ b/libavutil/x86/cpu.c
@@ -28,6 +28,20 @@
 #include "libavutil/cpu.h"
 #include "libavutil/cpu_internal.h"
 
+#if defined(RP_LEGACY) && defined(_WIN32)
+#include <windows.h>
+/* CPUID describes silicon, not the kernel's extended-state context switch.
+ * Win95 and early NT must never dispatch XMM code merely because a newer CPU
+ * was installed. A missing OS capability query is conservatively false. */
+static int rp_os_xmm(void)
+{
+    typedef BOOL (WINAPI *feature_query)(DWORD);
+    feature_query query = (feature_query)GetProcAddress(
+        GetModuleHandleA("KERNEL32.DLL"), "IsProcessorFeaturePresent");
+    return query && query(6); /* PF_XMMI_INSTRUCTIONS_AVAILABLE */
+}
+#endif
+
 #if HAVE_X86ASM
 
 #define cpuid(index, eax, ebx, ecx, edx)        \
@@ -81,6 +95,7 @@
     get_eflags(a);
     set_eflags(a ^ 0x200000);
     get_eflags(c);
+    set_eflags(a);
 
     return a != c;
 }
@@ -254,6 +269,13 @@
 
 #endif /* cpuid */
 
+#if defined(RP_LEGACY) && defined(_WIN32)
+    if (!rp_os_xmm())
+        rval &= AV_CPU_FLAG_MMX | AV_CPU_FLAG_MMXEXT | AV_CPU_FLAG_3DNOW |
+                AV_CPU_FLAG_3DNOWEXT | AV_CPU_FLAG_CMOV |
+                AV_CPU_FLAG_BMI1 | AV_CPU_FLAG_BMI2;
+#endif
+
     return rval;
 }
 
