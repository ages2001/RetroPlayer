 }
 
+#ifdef RP_LEGACY
+/* CRTDLL closes the original thread handle on exit. Keep the worker gated
+ * until its joinable duplicate and arguments have been published. */
+av_unused static void __cdecl legacy_thread_worker(void *arg)
+{
+    pthread_t thread = arg;
+    DWORD result = WaitForSingleObject(thread->gate, INFINITE);
+    CloseHandle(thread->gate);
+    if (result != WAIT_OBJECT_0 || thread->cancelled)
+        av_free(thread);
+    else
+        win32thread_worker(thread);
+    _endthread();
+}
+#endif
+
 av_unused static int pthread_create(pthread_t *thread, const void *unused_attr,
                                     void *(*start_routine)(void*), void *arg)
 {
@@ -91,7 +113,24 @@
 
     ret->func   = start_routine;
     ret->arg    = arg;
-#if HAVE_WINRT
+#if defined(RP_LEGACY)
+    ret->gate = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!ret->gate) { av_free(ret); return EAGAIN; }
+    uintptr_t original = _beginthread(legacy_thread_worker, 0, ret);
+    if (original == (uintptr_t)-1) {
+        CloseHandle(ret->gate); av_free(ret); return EAGAIN;
+    }
+    if (!DuplicateHandle(GetCurrentProcess(), (HANDLE)original,
+                         GetCurrentProcess(), &ret->handle, 0, FALSE,
+                         DUPLICATE_SAME_ACCESS)) {
+        ret->cancelled = 1;
+        SetEvent(ret->gate); /* The cancelled worker releases its own storage. */
+        return EAGAIN;
+    }
+    *thread = ret;
+    SetEvent(ret->gate);
+    return 0;
+#elif HAVE_WINRT
     ret->handle = (void*)CreateThread(NULL, 0, win32thread_worker, ret,
                                       0, NULL);
 #else
@@ -152,10 +191,13 @@
 av_unused static int pthread_once(pthread_once_t *once_control, void (*init_routine)(void))
 {
     BOOL pending = FALSE;
-    InitOnceBeginInitialize(once_control, 0, &pending, NULL);
-    if (pending)
+    if (!InitOnceBeginInitialize(once_control, 0, &pending, NULL))
+        return EINVAL;
+    if (pending) {
         init_routine();
-    InitOnceComplete(once_control, 0, NULL);
+        if (!InitOnceComplete(once_control, 0, NULL))
+            return EINVAL;
+    }
     return 0;
 }
 
