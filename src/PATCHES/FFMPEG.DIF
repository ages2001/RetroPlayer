         check_type ws2tcpip.h socklen_t
@@ -7009,8 +7017,15 @@
 done
 
 check_lib advapi32 "windows.h"            RegCloseKey          -ladvapi32
-check_lib bcrypt   "windows.h bcrypt.h"   BCryptGenRandom      -lbcrypt &&
-    check_cpp_condition bcrypt bcrypt.h "defined BCRYPT_RNG_ALGORITHM"
+# The legacy OS may have no cryptographic provider. Do not bind a Vista DLL
+# or report a weak seed as cryptographic random bytes. av_random_bytes keeps
+# its explicit failure; av_get_random_seed retains its upstream fallback.
+if test_cpp_condition windows.h "defined(RP_LEGACY)"; then
+    disable bcrypt
+else
+    check_lib bcrypt "windows.h bcrypt.h" BCryptGenRandom -lbcrypt &&
+        check_cpp_condition bcrypt bcrypt.h "defined BCRYPT_RNG_ALGORITHM"
+fi
 check_lib ole32    "windows.h objbase.h"  CoTaskMemFree        -lole32
 check_lib shell32  "windows.h shellapi.h" CommandLineToArgvW   -lshell32
 check_lib psapi    "windows.h psapi.h"    GetProcessMemoryInfo -lpsapi
@@ -7137,7 +7152,9 @@
 check_cpp_condition winrt windows.h "!WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)"
 
 if ! disabled w32threads && ! enabled pthreads; then
-    check_func_headers "windows.h process.h" _beginthreadex &&
+    thread_start_func=_beginthreadex
+    test_cpp_condition windows.h "defined(RP_LEGACY)" && thread_start_func=_beginthread
+    check_func_headers "windows.h process.h" $thread_start_func &&
         check_type "windows.h" CONDITION_VARIABLE &&
         check_type "windows.h" INIT_ONCE &&
         enable w32threads || disable w32threads
