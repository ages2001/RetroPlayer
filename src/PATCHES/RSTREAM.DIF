+static void Close(vlc_object_t *obj)
+{
+    filter_t *filter = (filter_t *)obj;
+    free(filter->p_sys);
+}
+
+static void Flush(filter_t *filter)
+{
+    filter->p_sys->phase = 0;
+    filter->p_sys->output_rate = filter->fmt_out.audio.i_rate;
+}
