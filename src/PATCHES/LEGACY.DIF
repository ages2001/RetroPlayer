--- /dev/null
+++ b/src/win32/RPCLOCK.H
@@ -0,0 +1,96 @@
+/* Legacy QEMU clock workaround. Included only by the Win32 clock backend.
+ * NT/Win9x PIT-based clocks can lose interrupts during emulated GDI work.
+ * Do not infer a reliable physical TSC from the instruction's presence alone.
+ */
+#include <cpuid.h>
+
+static struct {
+    uint64_t frequency, origin;
+    vlc_tick_t epoch;
+} rp_tsc_clock;
+
+static bool rp_tsc_available(void)
+{
+    unsigned a, b, c, d;
+    SYSTEM_INFO info;
+    if (!__get_cpuid(1, &a, &b, &c, &d) || !(d & (1U << 4)))
+        return false;
+    /* CPUID is known to exist before querying the hypervisor signature.
+     * Avoid assumptions about synchronized counters on multiprocessor hosts. */
+    GetSystemInfo(&info);
+    if (info.dwNumberOfProcessors != 1)
+        return false;
+    __cpuid(0x40000000, a, b, c, d);
+    char vendor[12];
+    memcpy(vendor, &b, 4);
+    memcpy(vendor + 4, &c, 4);
+    memcpy(vendor + 8, &d, 4);
+    return a >= 0x40000001 && !memcmp(vendor, "TCGTCGTCGTCG", 12);
+}
+
+static uint64_t rp_tsc_read(void)
+{
+    unsigned lo, hi;
+    __asm__ volatile("rdtsc" : "=a"(lo), "=d"(hi) : : "memory");
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static bool rp_tsc_setup(void)
+{
+    uint64_t ticks[8];
+    DWORD stamps[8];
+    if (!rp_tsc_available()) return false;
+    HMODULE timer = GetModuleHandleA("winmm.dll");
+    DWORD (WINAPI *read_ms)(void) = timer ?
+        (void *)GetProcAddress(timer, "timeGetTime") : NULL;
+    if (!read_ms) return false;
+    /* timeBeginPeriod can change the legacy clock's phase. On the supplied
+     * NT3.51 system its first interval jumps by about 14 ms. Let that change
+     * settle before taking the first calibration endpoint. */
+    Sleep(250);
+    /* The supplied NT3.51 HAL has a stable but incorrectly scaled QPC.
+     * Use the multimedia clock only during an idle calibration, before
+     * decoding/GDI can lose its timer interrupts. A long aggregate interval
+     * limits endpoint quantization error; inspect each shorter interval to
+     * reject stalls or lost ticks instead of averaging a discontinuity in.
+     * Never infer the frequency from the model name or a host MHz value. */
+    for (unsigned i = 0; i < ARRAY_SIZE(ticks); ++i) {
+        if (i) Sleep(250);
+        stamps[i] = read_ms();
+        ticks[i] = rp_tsc_read();
+        if (i && (ticks[i] <= ticks[i - 1] ||
+                  (DWORD)(stamps[i] - stamps[i - 1]) < 200 ||
+                  (DWORD)(stamps[i] - stamps[i - 1]) > 500))
+            return false;
+    }
+    const DWORD elapsed_ms = stamps[7] - stamps[0];
+    const uint64_t elapsed_ticks = ticks[7] - ticks[0];
+    /* Bound before multiplying, including malformed or discontinuous
+     * counters. At the maximum accepted rate this permits four seconds. */
+    if (elapsed_ticks > 400000000000ULL) return false;
+    const uint64_t rate = elapsed_ticks * 1000 / elapsed_ms;
+    if (rate < 1000000 || rate > 100000000000ULL) return false;
+    for (unsigned i = 1; i < ARRAY_SIZE(ticks); ++i) {
+        const uint64_t part = ticks[i] - ticks[i - 1];
+        const uint64_t measured = part / rate * CLOCK_FREQ +
+            part % rate * CLOCK_FREQ / rate;
+        const uint64_t reference = (DWORD)(stamps[i] - stamps[i - 1]) * 1000ULL;
+        const uint64_t error = measured > reference ?
+            measured - reference : reference - measured;
+        if (error > 5000 + reference / 2000) return false;
+    }
+    rp_tsc_clock.frequency = rate;
+    rp_tsc_clock.epoch = (vlc_tick_t)GetTickCount() * 1000 + 1;
+    rp_tsc_clock.origin = rp_tsc_read();
+    return true;
+}
+
+static vlc_tick_t mdate_tsc(void)
+{
+    const uint64_t ticks = rp_tsc_read() - rp_tsc_clock.origin;
+    const uint64_t frequency = rp_tsc_clock.frequency;
+    /* Split before multiplying so a long-running process cannot overflow
+     * merely because its counter has accumulated many CPU cycles. */
+    return rp_tsc_clock.epoch + ticks / frequency * CLOCK_FREQ +
+        ticks % frequency * CLOCK_FREQ / frequency;
+}
--- /dev/null
+++ b/src/win32/RPLOAD.H
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Validate static imports without executing a DLL. Old NT loaders can lose
+ * shared dependency references while rolling back an unresolved import.
+ * A failed optional plugin must not invalidate the running VLC core.
+ */
+#include <stdint.h>
+
+typedef struct {
+    wchar_t path[MAX_PATH];
+    HANDLE file, mapping;
+    unsigned char *bytes;
+    DWORD size;
+    IMAGE_NT_HEADERS32 *nt;
+    IMAGE_SECTION_HEADER *sections;
+    unsigned state;
+} rp_pe;
+typedef struct { rp_pe images[64]; unsigned count; } rp_images;
+#ifdef RP_PREFLIGHT
+static char rp_last_dll[260],rp_last_symbol[260];
+static void rp_trace_symbol(char *out,const char *in)
+{
+    unsigned i=0;
+    while(i<259 && in[i]) { out[i]=in[i];++i; }
+    out[i]=0;
+}
+#endif
+
+static void *rp_offset(rp_pe *p, DWORD offset, size_t size)
+{
+    if (offset > p->size || size > p->size-offset) return NULL;
+    return p->bytes+offset;
+}
+static void *rp_rva(rp_pe *p, DWORD rva, size_t size)
+{
+    if (rva < p->nt->OptionalHeader.SizeOfHeaders &&
+        size <= p->nt->OptionalHeader.SizeOfHeaders-rva)
+        return rp_offset(p,rva,size);
+    for (unsigned i=0;i<p->nt->FileHeader.NumberOfSections;++i) {
+        IMAGE_SECTION_HEADER *s=p->sections+i;
+        if (rva < s->VirtualAddress) continue;
+        DWORD off=rva-s->VirtualAddress;
+        if (off <= s->SizeOfRawData && size <= s->SizeOfRawData-off &&
+            s->PointerToRawData <= UINT32_MAX-off)
+            return rp_offset(p,s->PointerToRawData+off,size);
+    }
+    return NULL;
+}
+static const char *rp_string(rp_pe *p,DWORD rva)
+{
+    /* PE symbol/module names are bounded here before any C string operation. */
+    for(unsigned n=0;n<4096 && rva<=UINT32_MAX-n;++n) {
+        const char *end=rp_rva(p,rva+n,1);
+        if(!end) return NULL;
+        if(!*end) return rp_rva(p,rva,n+1);
+    }
+    return NULL;
+}
+static rp_pe *rp_map(rp_images *all,const wchar_t *path)
+{
+    for(unsigned i=0;i<all->count;++i)
+        if(!wcscmp(all->images[i].path,path)) return all->images+i;
+    if(all->count==64 || wcslen(path)>=MAX_PATH) return NULL;
+    rp_pe *p=all->images+all->count++;
+    wcscpy(p->path,path);
+    p->file=CreateFileW(path,GENERIC_READ,FILE_SHARE_READ,NULL,OPEN_EXISTING,0,NULL);
+    if(p->file==INVALID_HANDLE_VALUE) return NULL;
+    DWORD high=0;
+    p->size=GetFileSize(p->file,&high);
+    if(high || p->size==INVALID_FILE_SIZE || p->size<sizeof(IMAGE_DOS_HEADER)) return NULL;
+    p->mapping=CreateFileMappingA(p->file,NULL,PAGE_READONLY,0,0,NULL);
+    if(!p->mapping) return NULL;
+    p->bytes=MapViewOfFile(p->mapping,FILE_MAP_READ,0,0,0);
+    if(!p->bytes) return NULL;
+    IMAGE_DOS_HEADER *dos=(void *)p->bytes;
+    if(dos->e_magic!=IMAGE_DOS_SIGNATURE || dos->e_lfanew<0) return NULL;
+    DWORD off=(DWORD)dos->e_lfanew;
+    p->nt=rp_offset(p,off,sizeof(*p->nt));
+    if(!p->nt || p->nt->Signature!=IMAGE_NT_SIGNATURE ||
+       p->nt->FileHeader.Machine!=IMAGE_FILE_MACHINE_I386 ||
+       p->nt->FileHeader.SizeOfOptionalHeader<sizeof(IMAGE_OPTIONAL_HEADER32) ||
+       p->nt->OptionalHeader.Magic!=IMAGE_NT_OPTIONAL_HDR32_MAGIC ||
+       p->nt->OptionalHeader.NumberOfRvaAndSizes<2) return NULL;
+    size_t sect=(size_t)off+offsetof(IMAGE_NT_HEADERS32,OptionalHeader)+
+                p->nt->FileHeader.SizeOfOptionalHeader;
+    if(sect>UINT32_MAX) return NULL;
+    p->sections=rp_offset(p,(DWORD)sect,
+        (size_t)p->nt->FileHeader.NumberOfSections*sizeof(*p->sections));
+    if(!p->sections) return NULL;
+    return p;
+}
+static BOOL rp_imports(rp_images *,rp_pe *,unsigned);
+static BOOL rp_symbol(rp_images *all,const char *dll,const char *name,
+                      unsigned ordinal,unsigned depth)
+{
+#ifdef RP_PREFLIGHT
+    rp_trace_symbol(rp_last_dll,dll);rp_trace_symbol(rp_last_symbol,name?name:"<ordinal>");
+#endif
+    if(depth>64) { SetLastError(ERROR_BAD_EXE_FORMAT);return FALSE; }
+    HMODULE loaded=GetModuleHandleA(dll);
+    if(loaded) {
+        if(GetProcAddress(loaded,name ? name : (LPCSTR)(uintptr_t)ordinal)) return TRUE;
+        /* Win9x's public GetProcAddress hides some private KERNEL32 ordinals
+         * used by installed system DLLs. Validate those static exports from
+         * the actual loaded module's file, without loading dependencies. */
+        if(name || !(GetVersion()&0x80000000UL)) {
+            SetLastError(ERROR_PROC_NOT_FOUND);return FALSE;
+        }
+    }
+    char path[MAX_PATH];wchar_t wide[MAX_PATH];
+    DWORD length=loaded ? GetModuleFileNameA(loaded,path,MAX_PATH) :
+                          SearchPathA(NULL,dll,NULL,MAX_PATH,path,NULL);
+    if(!length || length>=MAX_PATH ||
+       !MultiByteToWideChar(CP_ACP,0,path,-1,wide,MAX_PATH)) {
+        SetLastError(ERROR_MOD_NOT_FOUND);return FALSE;
+    }
+    rp_pe *p=rp_map(all,wide);
+    if(!p) { SetLastError(ERROR_BAD_EXE_FORMAT);return FALSE; }
+    if(!loaded && !rp_imports(all,p,depth+1)) return FALSE;
+    IMAGE_DATA_DIRECTORY dir=p->nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+    IMAGE_EXPORT_DIRECTORY *exp=dir.VirtualAddress ? rp_rva(p,dir.VirtualAddress,sizeof(*exp)) : NULL;
+    if(!exp) { SetLastError(ERROR_PROC_NOT_FOUND);return FALSE; }
+    DWORD index=UINT32_MAX;
+    if(!name) {
+        if(ordinal>=exp->Base) index=ordinal-exp->Base;
+    } else {
+        if(exp->NumberOfNames>p->size/sizeof(DWORD)) goto malformed;
+        DWORD *names=rp_rva(p,exp->AddressOfNames,(size_t)exp->NumberOfNames*sizeof(DWORD));
+        WORD *ordinals=rp_rva(p,exp->AddressOfNameOrdinals,(size_t)exp->NumberOfNames*sizeof(WORD));
+        if(!names || !ordinals) goto malformed;
+        for(DWORD i=0;i<exp->NumberOfNames;++i) {
+            const char *candidate=rp_string(p,names[i]);
+            if(!candidate) goto malformed;
+            if(!strcmp(name,candidate)) { index=ordinals[i];break; }
+        }
+    }
+    if(index>=exp->NumberOfFunctions) { SetLastError(ERROR_PROC_NOT_FOUND);return FALSE; }
+    if(exp->NumberOfFunctions>p->size/sizeof(DWORD)) goto malformed;
+    DWORD *functions=rp_rva(p,exp->AddressOfFunctions,(size_t)exp->NumberOfFunctions*sizeof(DWORD));
+    if(!functions || !functions[index]) goto malformed;
+    DWORD rva=functions[index];
+    if(rva>=dir.VirtualAddress && rva-dir.VirtualAddress<dir.Size) {
+        const char *forward=rp_string(p,rva);
+        if(!forward) goto malformed;
+        const char *dot=strrchr(forward,'.');
+        char target[MAX_PATH];
+        if(!dot || dot==forward || !dot[1] || (size_t)(dot-forward)>MAX_PATH-5) goto malformed;
+        memcpy(target,forward,dot-forward);strcpy(target+(dot-forward),".dll");
+        if(dot[1]!='#') return rp_symbol(all,target,dot+1,0,depth+1);
+        unsigned number=0;
+        for(const char *c=dot+2;*c;++c) {
+            if(*c<'0' || *c>'9' || number>6553) goto malformed;
+            number=number*10+(*c-'0');
+        }
+        if(!number || number>65535) goto malformed;
+        return rp_symbol(all,target,NULL,number,depth+1);
+    }
+    return TRUE;
+malformed:
+    SetLastError(ERROR_BAD_EXE_FORMAT);return FALSE;
+}
+static BOOL rp_imports(rp_images *all,rp_pe *p,unsigned depth)
+{
+    if(depth>64) { SetLastError(ERROR_BAD_EXE_FORMAT);return FALSE; }
+    if(p->state) return TRUE; /* Dependencies may contain a legitimate cycle. */
+    p->state=1;
+    IMAGE_DATA_DIRECTORY dir=p->nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+    if(!dir.VirtualAddress) { p->state=2;return TRUE; }
+    for(DWORD offset=0;offset<dir.Size;) {
+        if(dir.VirtualAddress>UINT32_MAX-offset) break;
+        IMAGE_IMPORT_DESCRIPTOR *desc=rp_rva(p,dir.VirtualAddress+offset,sizeof(*desc));
+        if(!desc) break;
+        if(!desc->Name) { p->state=2;return TRUE; }
+        const char *dll=rp_string(p,desc->Name);
+        if(!dll || !*dll) break;
+        DWORD thunk=desc->OriginalFirstThunk ? desc->OriginalFirstThunk : desc->FirstThunk;
+        if(!thunk) break;
+        for(DWORD n=0;;++n) {
+            if(n>=p->size/4 || thunk>UINT32_MAX-n*4) goto malformed;
+            DWORD *entry=rp_rva(p,thunk+n*4,sizeof(DWORD));
+            if(!entry) goto malformed;
+            if(!*entry) break;
+            unsigned ordinal=0;const char *name=NULL;
+            if(*entry&IMAGE_ORDINAL_FLAG32) ordinal=*entry&0xffff;
+            else {
+                if(*entry>UINT32_MAX-2) goto malformed;
+                name=rp_string(p,*entry+2);
+                if(!name) goto malformed;
+            }
+            if(!rp_symbol(all,dll,name,ordinal,depth+1)) return FALSE;
+        }
+        if(offset>UINT32_MAX-sizeof(*desc)) break;
+        offset+=sizeof(*desc);
+    }
+malformed:
+    SetLastError(ERROR_BAD_EXE_FORMAT);return FALSE;
+}
+static BOOL rp_preflight(const wchar_t *path)
+{
+    rp_images *all=calloc(1,sizeof(*all));
+    if(!all) { SetLastError(ERROR_NOT_ENOUGH_MEMORY);return FALSE; }
+    rp_pe *root=rp_map(all,path);
+    BOOL result=root && rp_imports(all,root,0);
+    DWORD error=result ? ERROR_SUCCESS : root ? GetLastError() : ERROR_BAD_EXE_FORMAT;
+    for(unsigned i=0;i<all->count;++i) {
+        rp_pe *p=all->images+i;
+        if(p->bytes) UnmapViewOfFile(p->bytes);
+        if(p->mapping) CloseHandle(p->mapping);
+        if(p->file && p->file!=INVALID_HANDLE_VALUE) CloseHandle(p->file);
+    }
+    free(all);SetLastError(error);return result;
+}
