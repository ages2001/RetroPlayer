+{ (void)window; (void)projected; *gesture=NULL; return FALSE; }
+static inline LRESULT DecodeGesture(vlc_object_t *object,win32_gesture_sys_t *gesture,
+    HWND window,UINT message,WPARAM wparam,LPARAM lparam)
+{ (void)object; (void)gesture; return DefWindowProc(window,message,wparam,lparam); }
+static inline void CloseGestures(win32_gesture_sys_t *gesture) { (void)gesture; }
+#else
 typedef struct win32_gesture_sys_t {
