--- /dev/null
+++ b/modules/text_renderer/freetype/fonts/RPFONTS.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Font discovery through FreeType on Windows versions without DirectWrite or
+ * Uniscribe. HarfBuzz performs shaping; this file discovers faces/fallbacks.
+ */
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+#include <vlc_common.h>
+#include <vlc_filter.h>
+#include <vlc_charset.h>
+#include <vlc_fs.h>
+#include <windows.h>
+#include <dirent.h>
+#include "../platform_fonts.h"
+
+static char *AppFont(const char *name)
+{
+    if(strchr(name,'\\') || strchr(name,'/') || strchr(name,':')) return strdup(name);
+    wchar_t path[MAX_PATH];
+    DWORD length=GetModuleFileNameW(GetModuleHandleA("LIBCORE.DLL"),path,MAX_PATH);
+    if(!length || length>=MAX_PATH) return NULL;
+    wchar_t *last=wcsrchr(path,L'\\');if(!last) return NULL;last[1]=0;
+    char *folder=FromWide(path),*result=NULL;
+    if(folder) { if(asprintf(&result,"%s%s",folder,name)<0) result=NULL;free(folder); }
+    return result;
+}
+static void AddFile(filter_t *filter,const char *path)
+{
+    filter_sys_t *sys=filter->p_sys;
+    FT_Face face;
+    if(FT_New_Face(sys->p_library,path,0,&face)) return;
+    FT_Long count=face->num_faces;
+    for(FT_Long index=0;index<count;++index) {
+        if(index && FT_New_Face(sys->p_library,path,index,&face)) continue;
+        if(face->family_name) {
+            char *key=ToLower(face->family_name);
+            if(key) {
+                vlc_family_t *family=vlc_dictionary_value_for_key(&sys->family_map,key);
+                if(!family) family=NewFamily(filter,face->family_name,&sys->p_families,&sys->family_map,key);
+                if(family) {
+                    char *copy=strdup(path);
+                    if(copy) NewFont(copy,index,!!(face->style_flags&FT_STYLE_FLAG_BOLD),
+                                    !!(face->style_flags&FT_STYLE_FLAG_ITALIC),family);
+                }
+                free(key);
+            }
+        }
+        FT_Done_Face(face);
+    }
+}
+static void AddDirectory(filter_t *filter,const char *folder)
+{
+    DIR *directory=vlc_opendir(folder);if(!directory) return;
+    const char *name;
+    while((name=vlc_readdir(directory))!=NULL) {
+        const char *ext=strrchr(name,'.');
+        if(!ext || (strcasecmp(ext,".ttf") && strcasecmp(ext,".ttc") &&
+                    strcasecmp(ext,".otf") && strcasecmp(ext,".fon"))) continue;
+        char *path;
+        if(asprintf(&path,"%s\\%s",folder,name)<0) continue;
+        AddFile(filter,path);free(path);
+    }
+    closedir(directory);
+}
+int RPFonts_Prepare(filter_t *filter)
+{
+    char *app=AppFont("DEJAVU.TTF");
+    if(app) { AddFile(filter,app);free(app); }
+    char windows[MAX_PATH],system[MAX_PATH];
+    UINT n=GetWindowsDirectoryA(windows,MAX_PATH);
+    if(n && n<MAX_PATH-7) {
+        strcat(windows,"\\FONTS");
+        char *folder=FromLocaleDup(windows);
+        if(folder) { AddDirectory(filter,folder);free(folder); }
+    }
+    n=GetSystemDirectoryA(system,MAX_PATH);
+    if(n && n<MAX_PATH) {
+        char *folder=FromLocaleDup(system);
+        if(folder) { AddDirectory(filter,folder);free(folder); }
+    }
+    return filter->p_sys->p_families ? VLC_SUCCESS : VLC_EGENERIC;
+}
+const vlc_family_t *RPFonts_GetFamily(filter_t *filter,const char *name)
+{
+    char *key=ToLower(name);if(!key) return NULL;
+    const vlc_family_t *family=vlc_dictionary_value_for_key(&filter->p_sys->family_map,key);
+    free(key);return family;
+}
+vlc_family_t *RPFonts_GetFallbacks(filter_t *filter,const char *name,uni_char_t point)
+{
+    VLC_UNUSED(name);VLC_UNUSED(point);
+    return filter->p_sys->p_families;
+}
+char *Dummy_Select(filter_t *filter,const char *name,bool bold,bool italic,int *index,uni_char_t point)
+{
+    VLC_UNUSED(filter);VLC_UNUSED(bold);VLC_UNUSED(italic);VLC_UNUSED(point);
+    if(index) *index=0;
+    return AppFont(name);
+}
