+
+/* Legacy mixers may render silence tens of milliseconds ahead of the DMA
+ * cursor. Starting at the first PTS then makes the actual sound late and
+ * causes sustained pitch changes in the core's drift correction. Measure
+ * the opened device with silent PCM while input is still buffering. Never
+ * assume that HDA and Sound Blaster have the same startup latency. */
+static bool WaveOutMeasureLatency(audio_output_t *aout,
+                                  const audio_sample_format_t *fmt)
+{
+    aout_sys_t *sys = aout->sys;
+    /* Keep the render-ahead ring supplied while observing its first 40 ms.
+     * A single 100 ms probe can run dry with a 70 ms hardware lead, making
+     * its reset/restart latency unlike the later continuous media stream.
+     * Separate <=32 KiB headers also respect Win9x's 16-bit mapper. */
+    if (!fmt->i_bytes_per_frame) return false;
+    const unsigned frames = __MIN(fmt->i_rate / 10,
+                                  32768 / fmt->i_bytes_per_frame);
+    if (!frames) return false;
+    const unsigned target = fmt->i_rate / 4;
+    const unsigned count = target / frames + (target % frames != 0);
+    if (!count || count > ARRAY_SIZE(sys->latency_headers)) return false;
+    const size_t bytes = (size_t)frames * fmt->i_bytes_per_frame;
+    bool prepared[16] = { false };
+    bool queued = true, measured = false;
+    vlc_tick_t latency = INT64_MAX;
+    for (unsigned i = 0; i < count; ++i) {
+        WAVEHDR *header = &sys->latency_headers[i];
+        memset(header, 0, sizeof(*header));
+        header->lpData = calloc(1, bytes);
+        if (!header->lpData) { queued = false; break; }
+        header->dwBufferLength = bytes;
+        if (waveOutPrepareHeader(sys->h_waveout, header, sizeof(*header)) != MMSYSERR_NOERROR) {
+            queued = false; break;
+        }
+        prepared[i] = true;
+        if (waveOutWrite(sys->h_waveout, header, sizeof(*header)) != MMSYSERR_NOERROR) {
+            queued = false; break;
+        }
+    }
+    if (queued) {
+        const vlc_tick_t start = mdate();
+        if (waveOutRestart(sys->h_waveout) == MMSYSERR_NOERROR) {
+            for (;;) {
+                MMTIME pos;
+                pos.wType = TIME_SAMPLES;
+                if (waveOutGetPosition(sys->h_waveout, &pos, sizeof(pos)) != MMSYSERR_NOERROR ||
+                    pos.wType != TIME_SAMPLES) break;
+                vlc_tick_t elapsed = mdate() - start;
+                if (pos.u.sample >= fmt->i_rate / 100 && pos.u.sample < frames * count) {
+                    vlc_tick_t estimate = elapsed - (vlc_tick_t)pos.u.sample * CLOCK_FREQ / fmt->i_rate;
+                    if (estimate < latency) latency = estimate;
+                    measured = true;
+                }
+                if (pos.u.sample >= fmt->i_rate / 25 || elapsed >= 500 * 1000) break;
+                msleep(2 * 1000);
+            }
+        }
+    }
+    if (waveOutReset(sys->h_waveout) != MMSYSERR_NOERROR) measured = false;
+    for (unsigned i = 0; i < count; ++i) {
+        WAVEHDR *header = &sys->latency_headers[i];
+        if (!header->lpData) continue;
+        if (!prepared[i] || waveOutUnprepareHeader(sys->h_waveout, header, sizeof(*header)) == MMSYSERR_NOERROR) {
+            free(header->lpData);
+            header->lpData = NULL;
+        } else {
+            /* Keep driver-owned memory alive; Stop retries after its reset. */
+            measured = false;
+            msg_Warn(aout, "waveOut latency buffer remains prepared");
+        }
+    }
+    sys->b_start_pending = waveOutPause(sys->h_waveout) == MMSYSERR_NOERROR;
+    if( measured && sys->b_start_pending )
+    {
+        sys->i_device_latency = __MAX(latency, 0);
+        msg_Dbg(aout, "waveOut measured startup latency: %ld us", (long)sys->i_device_latency);
+    }
+    else msg_Warn(aout, "waveOut startup latency measurement unavailable");
+    return measured && sys->b_start_pending;
+}
+
+/* Called under the audio-output lock, after submission or during drain.
+ * Driver completion callbacks only take sys->lock, never this output lock. */
+static bool WaveOutStartQueued(audio_output_t *aout)
+{
+    aout_sys_t *sys = aout->sys;
+    if( !sys->b_start_pending || !sys->i_frames ) return true;
+    int canc = vlc_savecancel();
+    if( sys->i_start_date > VLC_TICK_INVALID )
+        mwait(sys->i_start_date - sys->i_device_latency);
+    MMRESULT result = waveOutRestart(sys->h_waveout);
+    vlc_restorecancel(canc);
+    sys->b_start_pending = false;
+    if( result != MMSYSERR_NOERROR )
+    {
+        msg_Err(aout, "waveOutRestart failed (%u)", result);
+        waveOutReset(sys->h_waveout);
+        return false;
+    }
+    return true;
 }
 
