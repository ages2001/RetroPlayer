+#ifdef RP_LEGACY
+/* Winsock 1.1 has select(), but no event-selection API. The interruptible
+ * caller uses short bounded waits so cancellation does not require APCs. */
+int poll(struct pollfd *fds, unsigned nfds, int timeout)
+{
+    fd_set read_set, write_set, error_set;
+    struct timeval tv;
+    unsigned invalid = 0, active = 0;
+    if (nfds > FD_SETSIZE) { errno = EINVAL; return -1; }
+    FD_ZERO(&read_set); FD_ZERO(&write_set); FD_ZERO(&error_set);
+    for (unsigned i = 0; i < nfds; ++i) {
+        fds[i].revents = 0;
+        if (fds[i].fd < 0) continue;
+        int type, length = sizeof(type);
+        if (getsockopt(fds[i].fd, SOL_SOCKET, SO_TYPE, (char *)&type, &length)) {
+            if (WSAGetLastError() != WSAENOTSOCK) { errno = EIO; return -1; }
+            fds[i].revents = POLLNVAL; ++invalid; continue;
+        }
+        if (fds[i].events & POLLRDNORM) FD_SET(fds[i].fd, &read_set);
+        if (fds[i].events & POLLWRNORM) FD_SET(fds[i].fd, &write_set);
+        FD_SET(fds[i].fd, &error_set);
+        ++active;
+    }
+    if (invalid) timeout = 0;
+    if (!active) {
+        if (!invalid) Sleep(timeout < 0 ? INFINITE : (DWORD)timeout);
+        return invalid;
+    }
+    tv.tv_sec = timeout < 0 ? 0 : timeout / 1000;
+    tv.tv_usec = timeout < 0 ? 0 : (timeout % 1000) * 1000;
+    int ready = select(0, &read_set, &write_set, &error_set, timeout < 0 ? NULL : &tv);
+    if (ready == SOCKET_ERROR) {
+        int error = WSAGetLastError();
+        errno = error == WSAEINTR ? EINTR : error == WSAENOBUFS ? ENOMEM : EIO;
+        return -1;
+    }
+    unsigned count = invalid;
+    for (unsigned i = 0; i < nfds; ++i) {
+        int fd = fds[i].fd;
+        if (fd < 0 || fds[i].revents == POLLNVAL) continue;
+        if (FD_ISSET(fd, &read_set)) fds[i].revents |= fds[i].events & POLLRDNORM;
+        if (FD_ISSET(fd, &write_set)) fds[i].revents |= fds[i].events & POLLWRNORM;
+        if (FD_ISSET(fd, &error_set)) fds[i].revents |= POLLERR | (fds[i].events & POLLPRI);
+        if (fds[i].revents) ++count;
+    }
+    return count;
+}
+#else
