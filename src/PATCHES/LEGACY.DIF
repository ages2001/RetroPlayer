+/* Win9x exports the Unicode query but does not implement it. Preserve the
+ * native Unicode path on NT and convert actual ANSI device data on Win9x. */
+static MMRESULT rp_wave_caps(UINT_PTR device, LPWAVEOUTCAPSW output, UINT size)
+{
+    WAVEOUTCAPSA caps;
+    MMRESULT result;
+    if (!(GetVersion() & 0x80000000UL))
+        return waveOutGetDevCapsW(device, output, size);
+    if (!output || size < sizeof(*output)) return MMSYSERR_INVALPARAM;
+    result = waveOutGetDevCapsA(device, &caps, sizeof(caps));
+    if (result != MMSYSERR_NOERROR) return result;
+    output->wMid = caps.wMid; output->wPid = caps.wPid;
+    output->vDriverVersion = caps.vDriverVersion;
+    output->dwFormats = caps.dwFormats; output->wChannels = caps.wChannels;
+    output->wReserved1 = caps.wReserved1; output->dwSupport = caps.dwSupport;
+    if (!MultiByteToWideChar(CP_ACP, 0, caps.szPname, -1,
+                            output->szPname, MAXPNAMELEN))
+        return MMSYSERR_ERROR;
+    return MMSYSERR_NOERROR;
+}
+#undef waveOutGetDevCaps
+#define waveOutGetDevCaps rp_wave_caps
+#endif
