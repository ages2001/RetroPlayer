--- /dev/null
+++ b/modules/video_output/RPGDI.c
@@ -0,0 +1,239 @@
+/* Legacy embedded GDI output, LGPL-2.1-or-later.
+ * Uses ordinary DIB memory: CreateDIBSection is absent on Windows NT 3.1. */
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+#include <vlc_common.h>
+#include <vlc_plugin.h>
+#include <vlc_vout_display.h>
+#include <vlc_picture_pool.h>
+#include <windows.h>
+
+static int Open(vlc_object_t *);
+static void Close(vlc_object_t *);
+vlc_module_begin()
+    set_shortname("Legacy GDI")
+    set_description("Legacy Windows DIB video output")
+    set_category(CAT_VIDEO)
+    set_subcategory(SUBCAT_VIDEO_VOUT)
+    set_capability("vout display", 100)
+    add_shortcut("rpgdi")
+    set_callbacks(Open,Close)
+vlc_module_end()
+
+struct vout_display_sys_t {
+    HWND window;
+    picture_pool_t *pool;
+    picture_t *last;
+    vout_display_cfg_t config;
+    unsigned width,height;
+    mtime_t refreshed;
+    uint8_t *dib;
+    size_t dib_size;
+    HDC surface;
+    HBITMAP bitmap;
+    HGDIOBJ old_bitmap;
+    unsigned surface_width, surface_height, surface_depth;
+    bool prepared;
+    bool cache_valid;
+    unsigned cached_width, cached_height;
+    vout_display_place_t cached_place;
+};
+static picture_pool_t *Pool(vout_display_t *vd,unsigned count)
+{
+    if (!vd->sys->pool) vd->sys->pool=picture_pool_NewFromFormat(&vd->fmt,count);
+    return vd->sys->pool;
+}
+static bool Draw(vout_display_t *vd, picture_t *picture, HDC dc,
+                 const RECT *client)
+{
+    vout_display_sys_t *sys=vd->sys;
+    BITMAPINFO bitmap;
+    vout_display_place_t place;
+    unsigned width=vd->fmt.i_visible_width,height=vd->fmt.i_visible_height;
+    unsigned x=vd->fmt.i_x_offset,y=vd->fmt.i_y_offset;
+    size_t stride,size;
+    bool unchanged=sys->cache_valid && dc==sys->surface &&
+        sys->cached_width==width && sys->cached_height==height;
+    if (!picture || client->right<=0 || client->bottom<=0) return false;
+    /* Positive-height, 24-bit DIBs work with the original Win95 display
+     * drivers, including drivers that reject top-down 32-bit StretchDIBits.
+     * Copy just the visible image so source offsets use no DIB conventions. */
+    if (!width || !height || width>(SIZE_MAX-3)/3 ||
+        x>=(unsigned)picture->p[0].i_pitch/4 ||
+        width>(unsigned)picture->p[0].i_pitch/4-x ||
+        y>=(unsigned)picture->p[0].i_lines ||
+        height>(unsigned)picture->p[0].i_lines-y) return false;
+    stride=((size_t)width*3+3)&~(size_t)3;
+    if (height>SIZE_MAX/stride) return false;
+    size=stride*height;
+    if (size>sys->dib_size) {
+        uint8_t *dib=realloc(sys->dib,size);
+        if (!dib) return false;
+        sys->dib=dib; sys->dib_size=size;
+        unchanged=false;
+    }
+    for (unsigned row=0;row<height;row++) {
+        const uint8_t *src=picture->p[0].p_pixels+(size_t)(y+row)*picture->p[0].i_pitch+x*4;
+        uint8_t *dst=sys->dib+(height-1-row)*stride;
+        for (unsigned col=0;col<width;col++) {
+            if (unchanged && (dst[col*3]!=src[col*4] ||
+                dst[col*3+1]!=src[col*4+1] || dst[col*3+2]!=src[col*4+2]))
+                unchanged=false;
+            dst[col*3]=src[col*4]; dst[col*3+1]=src[col*4+1]; dst[col*3+2]=src[col*4+2];
+        }
+        memset(dst+width*3,0,stride-width*3);
+    }
+    sys->config.display.width=client->right;
+    sys->config.display.height=client->bottom;
+    vout_display_PlacePicture(&place,&vd->source,&sys->config,false);
+    /* VLC also prepares repeats while paused or waiting for the next frame.
+     * Compare actual pixels, including blended subtitles, rather than using
+     * timestamps or buffer addresses as a proxy for unchanged content. */
+    if (unchanged && place.x==sys->cached_place.x && place.y==sys->cached_place.y &&
+        place.width==sys->cached_place.width && place.height==sys->cached_place.height)
+        return true;
+    sys->cache_valid=false;
+    memset(&bitmap,0,sizeof(bitmap));
+    bitmap.bmiHeader.biSize=sizeof(BITMAPINFOHEADER);
+    bitmap.bmiHeader.biWidth=width;
+    bitmap.bmiHeader.biHeight=height;
+    bitmap.bmiHeader.biPlanes=1;
+    bitmap.bmiHeader.biBitCount=24;
+    bitmap.bmiHeader.biCompression=BI_RGB;
+    /* Clear only the letterbox borders; avoid flashing the video rectangle. */
+    PatBlt(dc,0,0,client->right,place.y,BLACKNESS);
+    PatBlt(dc,0,place.y+place.height,client->right,client->bottom-place.y-place.height,BLACKNESS);
+    PatBlt(dc,0,place.y,place.x,place.height,BLACKNESS);
+    PatBlt(dc,place.x+place.width,place.y,client->right-place.x-place.width,place.height,BLACKNESS);
+    SetStretchBltMode(dc,COLORONCOLOR);
+    int drawn=StretchDIBits(dc,place.x,place.y,place.width,place.height,
+        0,0,width,height,sys->dib,&bitmap,DIB_RGB_COLORS,SRCCOPY);
+    if (drawn==0 || drawn==GDI_ERROR)
+        msg_Err(vd,"StretchDIBits returned %d: %lu",drawn,GetLastError());
+    else if (dc==sys->surface) {
+        sys->cache_valid=true;
+        sys->cached_width=width; sys->cached_height=height;
+        sys->cached_place=place;
+    }
+    return drawn!=0 && drawn!=GDI_ERROR;
+}
+static void DeleteSurface(vout_display_sys_t *sys)
+{
+    if (sys->surface) {
+        SelectObject(sys->surface,sys->old_bitmap);
+        DeleteObject(sys->bitmap);
+        DeleteDC(sys->surface);
+    }
+    sys->surface=NULL;
+    sys->bitmap=NULL;
+    sys->prepared=false;
+    sys->cache_valid=false;
+}
+static void Prepare(vout_display_t *vd, picture_t *picture,
+                    subpicture_t *subpicture)
+{
+    vout_display_sys_t *sys=vd->sys;
+    RECT client;
+    VLC_UNUSED(subpicture);
+    sys->prepared=false;
+    if (!GetClientRect(sys->window,&client) ||
+        client.right<=0 || client.bottom<=0) return;
+    HDC dc=GetDC(sys->window);
+    if (!dc) return;
+    unsigned depth=GetDeviceCaps(dc,BITSPIXEL)*GetDeviceCaps(dc,PLANES);
+    if (!sys->surface || sys->surface_width!=(unsigned)client.right ||
+        sys->surface_height!=(unsigned)client.bottom || sys->surface_depth!=depth) {
+        /* Compatible bitmaps/DCs exist on NT3.1. Scale and quantize here so
+         * VLC measures this work before choosing the presentation deadline. */
+        HDC surface=CreateCompatibleDC(dc);
+        HBITMAP bitmap=surface ? CreateCompatibleBitmap(dc,client.right,client.bottom) : NULL;
+        HGDIOBJ old=bitmap ? SelectObject(surface,bitmap) : NULL;
+        if (!old || old==HGDI_ERROR) {
+            if (bitmap) DeleteObject(bitmap);
+            if (surface) DeleteDC(surface);
+            ReleaseDC(sys->window,dc);
+            return; /* Display retains the immediate DIB fallback. */
+        }
+        DeleteSurface(sys);
+        sys->surface=surface; sys->bitmap=bitmap; sys->old_bitmap=old;
+        sys->surface_width=client.right; sys->surface_height=client.bottom;
+        sys->surface_depth=depth;
+    }
+    ReleaseDC(sys->window,dc);
+    sys->prepared=Draw(vd,picture,sys->surface,&client);
+}
+static void Present(vout_display_t *vd)
+{
+    vout_display_sys_t *sys=vd->sys;
+    HDC dc=GetDC(sys->window);
+    if (!dc) return;
+    bool copied=sys->prepared && BitBlt(dc,0,0,sys->surface_width,
+                                       sys->surface_height,sys->surface,0,0,SRCCOPY);
+    if (!copied) {
+        RECT client;
+        if (GetClientRect(sys->window,&client)) Draw(vd,sys->last,dc,&client);
+    }
+    ReleaseDC(sys->window,dc);
+    sys->refreshed=mdate();
+}
+static void Display(vout_display_t *vd,picture_t *picture,subpicture_t *subpicture)
+{
+    if (vd->sys->last) picture_Release(vd->sys->last);
+    vd->sys->last=picture;
+    Present(vd);
+    VLC_UNUSED(subpicture);
+}
+static void Manage(vout_display_t *vd)
+{
+    RECT client;
+    if (GetClientRect(vd->sys->window,&client) && client.right>0 && client.bottom>0 &&
+        ((unsigned)client.right!=vd->sys->width || (unsigned)client.bottom!=vd->sys->height)) {
+        vd->sys->width=client.right; vd->sys->height=client.bottom;
+        vout_display_SendEventDisplaySize(vd,client.right,client.bottom);
+        if (vd->sys->last) {
+            Prepare(vd,vd->sys->last,NULL);
+            Present(vd);
+        }
+    }
+    /* Restore an exposed or resized window while playback is paused. */
+    if (vd->sys->last && mdate()-vd->sys->refreshed>=100000) Present(vd);
+}
+static int Control(vout_display_t *vd,int query,va_list args)
+{
+    switch(query) {
+    case VOUT_DISPLAY_CHANGE_DISPLAY_SIZE:
+    case VOUT_DISPLAY_CHANGE_DISPLAY_FILLED:
+    case VOUT_DISPLAY_CHANGE_ZOOM:
+        vd->sys->config=*va_arg(args,const vout_display_cfg_t *);
+        return VLC_SUCCESS;
+    case VOUT_DISPLAY_CHANGE_SOURCE_ASPECT:
+    case VOUT_DISPLAY_CHANGE_SOURCE_CROP:
+        return VLC_SUCCESS;
+    default: return VLC_EGENERIC;
+    }
+}
+static int Open(vlc_object_t *object)
+{
+    vout_display_t *vd=(vout_display_t *)object;
+    HWND window=(HWND)(uintptr_t)var_InheritInteger(vd,"drawable-hwnd");
+    if (!window || !IsWindow(window)) return VLC_EGENERIC;
+    vd->sys=calloc(1,sizeof(*vd->sys));
+    if (!vd->sys) return VLC_ENOMEM;
+    vd->sys->window=window; vd->sys->config=*vd->cfg;
+    video_format_ApplyRotation(&vd->fmt,&vd->source);
+    vd->fmt.i_chroma=VLC_CODEC_RGB32;
+    vd->fmt.i_rmask=0xff0000; vd->fmt.i_gmask=0x00ff00; vd->fmt.i_bmask=0x0000ff;
+    vd->pool=Pool; vd->prepare=Prepare; vd->display=Display; vd->manage=Manage; vd->control=Control;
+    vout_display_DeleteWindow(vd,NULL);
+    return VLC_SUCCESS;
+}
+static void Close(vlc_object_t *object)
+{
+    vout_display_t *vd=(vout_display_t *)object;
+    if (vd->sys->last) picture_Release(vd->sys->last);
+    if (vd->sys->pool) picture_pool_Release(vd->sys->pool);
+    DeleteSurface(vd->sys);
+    free(vd->sys->dib);
+    free(vd->sys);
+}
