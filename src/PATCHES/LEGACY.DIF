+/* Gather tiny codec packets before starting the paused device. Forty 2.5 ms
+ * Opus packets must not require forty driver queue entries to buffer 100 ms. */
+static block_t *WaveOutTakePrebuffer(audio_output_t *aout)
+{
+    aout_sys_t *sys = aout->sys;
+    block_t *chain = sys->p_prebuffer;
+    if( !chain ) return NULL;
+    unsigned samples = sys->i_prebuffer_samples;
+    sys->p_prebuffer = NULL;
+    sys->i_prebuffer_length = 0;
+    sys->i_prebuffer_samples = 0;
+    block_t *block = block_ChainGather(chain);
+    if( !block )
+    {
+        block_ChainRelease(chain);
+        msg_Err(aout, "cannot gather waveOut startup samples");
+    }
+    else block->i_nb_samples = samples;
+    return block;
+}
+
+static void WaveOutDiscardPrebuffer(aout_sys_t *sys)
+{
+    block_ChainRelease(sys->p_prebuffer);
+    sys->p_prebuffer = NULL;
+    sys->i_prebuffer_length = 0;
+    sys->i_prebuffer_samples = 0;
+}
+
+static void Play(audio_output_t *aout, block_t *block)
+{
+    aout_sys_t *sys = aout->sys;
+    /* Keep at least 20 ms per ordinary PCM write. Sixteen 2.5 ms headers
+     * provide only 40 ms of audio and can underrun a legacy driver's timer. */
+    const vlc_tick_t target = sys->b_start_pending ? 100 * 1000 : 20 * 1000;
+    if( !sys->b_spdif && (sys->p_prebuffer || block->i_length < target) )
+    {
+        sys->i_prebuffer_length += block->i_length;
+        sys->i_prebuffer_samples += block->i_nb_samples;
+        block_ChainAppend(&sys->p_prebuffer, block);
+        if( sys->i_prebuffer_length < target ) return;
+        block = WaveOutTakePrebuffer(aout);
+        if( !block ) return;
+    }
+    WaveOutSubmit(aout, block);
 }
 
