--- /dev/null
+++ b/include/RPTRACE.H
@@ -0,0 +1,27 @@
+/* Temporary diagnostics for the RetroPlayer engine bring-up. */
+#ifndef RP_TRACE_H
+#define RP_TRACE_H
+#if defined(RP_LEGACY) && !defined(RP_NOTRACE)
+#include <windows.h>
+static inline void rp_trace(const char *message)
+{
+    char path[MAX_PATH], *p, *last;
+    DWORD size, written;
+    HANDLE file;
+    size=GetModuleFileNameA(NULL,path,MAX_PATH);
+    if (!size || size>=MAX_PATH-16) return;
+    last=path;
+    for (p=path; *p; ++p) if (*p=='\\') last=p+1;
+    lstrcpyA(last,"TRACE.TXT");
+    file=CreateFileA(path,GENERIC_WRITE,FILE_SHARE_READ|FILE_SHARE_WRITE,NULL,OPEN_ALWAYS,FILE_ATTRIBUTE_NORMAL,NULL);
+    if (file==INVALID_HANDLE_VALUE) return;
+    SetFilePointer(file,0,NULL,FILE_END);
+    size=(DWORD)lstrlenA(message);
+    WriteFile(file,message,size,&written,NULL);
+    WriteFile(file,"\r\n",2,&written,NULL);
+    CloseHandle(file);
+}
+#else
+#define rp_trace(message) ((void)0)
+#endif
+#endif
