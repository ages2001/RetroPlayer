+static int ThreadDisplayPicture(vout_thread_t *vout, vlc_tick_t *deadline)
+{
+    /* Publish before removing from decoder_fifo so EOF cannot race the last
+     * scheduled frame. Only the display thread touches displayed.next. */
+    atomic_store(&vout->p->display_pending, true);
