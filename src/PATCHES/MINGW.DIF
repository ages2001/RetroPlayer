--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -1,3 +1,4 @@
+#include "/workspace/RETRO/SRC/RP386.H"
 /**
  * This file has no copyright assigned and is placed in the Public Domain.
  * This file is part of the mingw-w64 runtime package.
--- a/mingw-w64-crt/crt/tlssup.c
+++ b/mingw-w64-crt/crt/tlssup.c
@@ -45,7 +45,9 @@
 _CRTALLOC(".CRT$XLZ") PIMAGE_TLS_CALLBACK __xl_z = 0;
 
 __attribute__((used))
-const IMAGE_TLS_DIRECTORY _tls_used = {
+/* Win9x rejects DLLs carrying a native PE TLS directory. GCC TLS is
+ * provided by RPCRT; run the CRT callback table from DLL startup instead. */
+const IMAGE_TLS_DIRECTORY rp_tls_directory = {
   (ULONG_PTR) &_tls_start, (ULONG_PTR) &_tls_end,
   (ULONG_PTR) &_tls_index, (ULONG_PTR) (&__xl_a+1),
   (ULONG) 0, (ULONG) 0
@@ -174,3 +176,14 @@
 int __mingw_initltsdrot_force = 0;
 int __mingw_initltsdyn_force = 0;
 int __mingw_initltssuo_force = 0;
+
+/* Match loader callback notifications without requiring native PE TLS. */
+void rp_crt_tls_dispatch(HANDLE module, DWORD reason, LPVOID reserved)
+{
+    uintptr_t first = (uintptr_t)(&__xl_a + 1);
+    uintptr_t end = (uintptr_t)&__xl_z;
+    for (; first < end; first += sizeof(PIMAGE_TLS_CALLBACK)) {
+        PIMAGE_TLS_CALLBACK callback = *(PIMAGE_TLS_CALLBACK *)first;
+        if (callback) callback(module, reason, reserved);
+    }
+}
